APP_PORT=8080
DB_NAME=foodbattle
DB_USER=foodbattle
DB_PASSWORD=changez_moi
# Hash bcrypt du mot de passe admin. Les apostrophes simples sont OBLIGATOIRES :
# avec des guillemets, Docker Compose interprète les $ et coupe le hash.
# Générer un hash : docker compose exec app php -r "echo password_hash('votre_mot_de_passe', PASSWORD_DEFAULT);"
ADMIN_NICKNAME='Admin'
ADMIN_EMAIL='admin@exemple.com'
ADMIN_PASSWORD_HASH='remplacez_par_un_hash'